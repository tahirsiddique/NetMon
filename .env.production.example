# Digiskills Network Monitoring System - Production Environment Configuration
# Copy this file to .env.production and update with your production values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL=https://monitor.digiskills.local

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=digiskills_monitor
DB_USER=monitor_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!

# Connection pool settings
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# =============================================================================
# JWT/AUTHENTICATION
# =============================================================================
# IMPORTANT: Generate a strong random secret for production!
# Use: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_AND_RANDOM_SECRET_STRING
JWT_EXPIRATION=8h

# Session settings
SESSION_DURATION=8h
SESSION_CLEANUP_INTERVAL=1h

# Security settings
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION=15
SUSPICIOUS_REQUEST_THRESHOLD=100

# =============================================================================
# EMAIL/SMTP CONFIGURATION
# =============================================================================
SMTP_HOST=smtp.digiskills.local
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=monitor@digiskills.local
SMTP_PASS=CHANGE_THIS_EMAIL_PASSWORD
SMTP_FROM=Digiskills Monitor <monitor@digiskills.local>

# Alert email recipients
ADMIN_EMAIL=admin@digiskills.local
ALERT_EMAIL_RECIPIENTS=admin@digiskills.local,ops@digiskills.local

# =============================================================================
# ALERT SYSTEM
# =============================================================================
# Alert evaluation interval in milliseconds (60000 = 1 minute)
ALERT_EVAL_INTERVAL=60000

# Alert cooldown period in milliseconds (300000 = 5 minutes)
ALERT_COOLDOWN_PERIOD=300000

# =============================================================================
# WHATSAPP NOTIFICATIONS
# =============================================================================
# Enable WhatsApp notifications for critical alerts
WHATSAPP_ENABLED=false

# WhatsApp provider: twilio, cloud-api, or webhook
WHATSAPP_PROVIDER=twilio

# Admin phone numbers (comma-separated, include country code)
# Format: +923001234567,+923009876543
WHATSAPP_ADMIN_NUMBERS=+923001234567

# --- OPTION 1: Twilio WhatsApp API (Recommended) ---
# Get credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- OPTION 2: WhatsApp Business Cloud API ---
# Get credentials from: https://developers.facebook.com/
WHATSAPP_CLOUD_API_TOKEN=your_cloud_api_token
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=your_phone_number_id

# --- OPTION 3: Custom Webhook ---
# Use your own WhatsApp service endpoint
WHATSAPP_WEBHOOK_URL=https://your-whatsapp-service.com/api/send
WHATSAPP_WEBHOOK_API_KEY=your_webhook_api_key

# =============================================================================
# ZABBIX INTEGRATION
# =============================================================================
ZABBIX_API_URL=http://zabbix.digiskills.local/api_jsonrpc.php
ZABBIX_API_USER=Admin
ZABBIX_API_PASSWORD=CHANGE_THIS_ZABBIX_PASSWORD

# =============================================================================
# NETFLOW/SFLOW CONFIGURATION
# =============================================================================
NETFLOW_COLLECTOR_PORT=2055
SFLOW_COLLECTOR_PORT=6343

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_DIR=/app/logs

# =============================================================================
# DOCKER/DEPLOYMENT
# =============================================================================
# Exposed ports
HTTP_PORT=80
HTTPS_PORT=443

# Docker network
DOCKER_NETWORK=netmon-network

# =============================================================================
# MONITORING & PERFORMANCE
# =============================================================================
# Enable performance monitoring
ENABLE_PERFORMANCE_MONITORING=true

# Request timeout in milliseconds
REQUEST_TIMEOUT=30000

# Max request body size
MAX_REQUEST_SIZE=20mb

# =============================================================================
# SECURITY
# =============================================================================
# Enable HTTPS (requires SSL certificates)
ENABLE_HTTPS=false

# SSL certificate paths (if ENABLE_HTTPS=true)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Enable rate limiting
ENABLE_RATE_LIMITING=true

# Rate limit window (milliseconds)
RATE_LIMIT_WINDOW=900000

# Rate limit max requests
RATE_LIMIT_MAX=100

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_WEBSOCKETS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_EMAIL_NOTIFICATIONS=true

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# Slack webhook for notifications
SLACK_WEBHOOK_URL=

# PagerDuty integration
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=

# =============================================================================
# MAINTENANCE
# =============================================================================
# Maintenance mode (disables non-critical endpoints)
MAINTENANCE_MODE=false

# Maintenance message
MAINTENANCE_MESSAGE=System is currently under maintenance. Please try again later.
