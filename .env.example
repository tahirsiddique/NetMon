# Database
DATABASE_URL=postgresql://monitor_user:SecurePassword123!@localhost:5432/digiskills_monitor
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=YourSuperSecretJWTKeyChangeInProduction
AD_LDAP_URL=ldap://dc.digiskills.local:389
AD_DOMAIN=digiskills.local
AD_BASE_DN=DC=digiskills,DC=local

# Email Notifications
SMTP_HOST=smtp.digiskills.local
SMTP_PORT=587
SMTP_USER=monitor@digiskills.local
SMTP_PASS=EmailPassword
ADMIN_EMAIL=admin@digiskills.local

# Alert System
ALERT_EVAL_INTERVAL=60000

# Application
APP_URL=http://monitor.digiskills.local
NODE_ENV=development
PORT=3000

# Zabbix Integration
ZABBIX_URL=http://zabbix.digiskills.local/api_jsonrpc.php
ZABBIX_USER=api_user
ZABBIX_PASSWORD=ApiPassword
ZABBIX_SYNC_INTERVAL=300000

# Device Credentials (Store securely in production)
WMI_USERNAME=DIGISKILLS\\monitor_service
WMI_PASSWORD=ServiceAccountPassword
SNMP_COMMUNITY=public

# NetFlow Collector
NETFLOW_PORT=2055
SYSLOG_PORT=514
